#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/stp.h>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
      #include "macros.dtsi"
      #include "version.dtsi"

      hm: homerow_mods {
          compatible = "zmk,behavior-hold-tap";
          label = "HOMEROW_MODS";
          #binding-cells = <2>;
          tapping-term-ms = <200>;
          quick_tap_ms = <0>;
          flavor = "tap-preferred";
          require-prior-idle-ms = <125>;
          bindings = <&kp>, <&kp>;
      };

      /*
      * Default from Kinesis:
      *
      * hm: homerow_mods {
      *     compatible = "zmk,behavior-hold-tap";
      *     label = "HOMEROW_MODS";
      *     #binding-cells = <2>;
      *     tapping-term-ms = <200>;
      *     quick_tap_ms = <175>;
      *     flavor = "tap-preferred";
      *     bindings = <&kp>, <&kp>;
      * };
      */
    };

/*
* Default Colemak layer:
*
* ,--------+------+------+------+------+------+---------------------------+------+------+------+------+------+--------.
* | =+     |  1!  |  2@  |  3#  |  4$  |  5%  |Keypad|             | Mod  |  6^  |  7&  |  8*  |  9(  |  0)  | -_     |
* |--------+------+------+------+------+------|------|             |------+------+------+------+------+------+--------|
* | Tab    |   Q  |   W  |   F  |   P  |   G  | Base |             |      |   J  |   L  |   U  |   Y  |  ;:  | \|     |
* |--------+------+------+------+------+------|------|             |------|------+------+------+------+------+--------|
* | Esc    |   A  |   R  |   S  |   T  |   D  |Qwerty|             |      |   H  |   N  |   E  |   I  |   O  | '"     |
* |--------+------+------+------+------+------|------'             `------|------+------+------+------+------+--------|
* | Shift  |ALT(Z)|CTL(X)|SFT(C)|GUI(V)|   B  |                           |   K  |GUI(M)|SFT(,)|CTL(.)|ALT(/)| Shift  |
* `--------+------+------+------+------+-------                           `------+------+------+------+------+--------'
* | Func   | `~   |  '"  | Left | Right|                                         | Down |  Up  |  [{  |  ]}  | Func   |
* `--------`---------------------------'                                         `---------------------------'--------'
*                                        ,-------------.         ,-------------.
*                                        | Bksp | Gui  |         | Gui  | Ctrl |
*                                 ,------|------|------|         |------+------+------.
*                                 |      |      | Alt  |         | Alt  |      |      |
*                                 |Space |Enter |------|         |------| Enter| Space|
*                                 |      |      | Ctrl |         | Ctrl |      |      |
*                                 `--------------------'         `--------------------'
*/


  keymap {
    compatible = "zmk,keymap";

    default_layer {
      display-name = "Base";
      bindings = <
        &kp EQUAL &kp N1     &kp N2      &kp N3      &kp N4     &kp N5 &tog 2                                                             &mo 4        &kp N6   &kp N7     &kp N8          &kp N9        &kp N0         &kp MINUS
        &kp TAB   &kp Q      &kp W       &kp F       &kp P      &kp G  &to 0                                                              &kp C_VOL_UP &kp J    &kp L      &kp U           &kp Y         &kp SEMI       &kp BSLH
        &kp ESC   &kp A      &kp R       &kp S       &kp T      &kp D  &to 1            &kp BSPC &kp LGUI   &kp RGUI  &kp BSPC            &kp C_VOL_DN &kp H    &kp N      &kp E           &kp I         &kp O          &kp SQT
        &kp LSHFT &hm LALT Z &hm LCTRL X &hm LSHFT C &hm LGUI V &kp B                            &kp LALT  &kp RALT                                    &kp K    &hm RGUI M &hm RSHFT COMMA &hm RCTRL DOT &hm RALT SLASH &kp RSHFT
        &mo 3     &kp GRAVE  &caps_word  &kp LEFT    &kp RIGHT               &kp SPACE &kp ENTER &kp LCTRL &kp RCTRL &kp ENTER &kp SPACE                        &kp DOWN   &kp UP          &kp LBKT      &kp RBKT       &mo 3
      >;
    };

    qwerty {
      display-name = "Qwerty";
      bindings = <
        &trans  &trans  &trans  &trans  &trans  &trans  &trans                                               &trans  &trans  &trans  &trans     &trans   &trans     &trans
        &trans  &kp Q   &kp W   &kp E   &kp R   &kp T   &to 0                                                &trans  &kp Y   &kp U   &kp I      &kp O    &kp P      &trans
        &trans  &kp A   &kp S   &kp D   &kp F   &kp G   &trans      &trans &trans  &trans &trans             &trans  &kp H   &kp J   &kp K      &kp L    &kp SEMI   &trans
        &trans  &kp Z   &kp X   &kp C   &kp V   &kp B                      &trans  &trans                            &kp N   &kp M   &kp COMMA  &kp DOT  &kp SLASH  &trans
        &trans  &trans  &trans  &trans  &trans               &trans &trans &trans  &trans &trans &trans                      &trans  &trans     &trans   &trans     &trans
      >;
    };

    keypad {
      display-name = "Kp";
      bindings = <
        &trans   &trans     &trans    &trans    &trans      &trans  &trans                                                 &trans &trans  &kp KP_NUM &kp KP_EQUAL &kp KP_DIVIDE &kp KP_MULTIPLY &trans
        &trans   &trans     &trans    &trans    &trans      &trans  &trans                                                 &trans &trans  &kp KP_N7  &kp KP_N8    &kp KP_N9     &kp KP_MINUS    &trans
        &trans   &trans     &trans    &trans    &trans      &trans  &trans           &trans &trans  &trans &trans          &trans &trans  &kp KP_N4  &kp KP_N5    &kp KP_N6     &kp KP_PLUS     &trans
        &trans   &trans     &trans    &trans    &trans      &trans                         &trans  &trans                         &trans  &kp KP_N1  &kp KP_N2    &kp KP_N3     &kp KP_ENTER    &trans
        &trans   &trans     &trans    &trans    &trans                       &trans &trans &trans  &trans &trans &trans                   &kp KP_N0  &trans       &kp KP_DOT    &trans          &trans
      >;
    };

    fn {
      display-name = "Fn";
      bindings = <
        &kp F1 &kp F2 &kp F3 &kp F4 &kp F5 &kp F6  &trans                                           &kp C_PP   &kp F7 &kp F8 &kp F9 &kp F10 &kp F11 &kp F12
        &trans &trans &trans &trans &trans &trans  &mo 5                                            &kp C_NEXT &trans &trans &trans &trans  &trans  &trans
        &trans &trans &trans &trans &trans &trans  &trans        &trans &trans &trans &trans        &kp C_PREV &trans &trans &trans &trans  &trans  &trans
        &trans &trans &trans &trans &trans &trans                      &trans &trans                           &trans &trans &trans &trans  &trans  &trans
        &trans &trans &trans &trans &trans               &trans &trans &trans &trans &trans &trans                    &trans &trans &trans  &trans  &trans
      >;
    };

    mod {
      display-name = "Mod";
      bindings = <
        &none &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &none                                                                     &trans                 &none        &none        &none        &none &none &none
        &none &none        &none        &none        &none        &none        &bootloader                                                               &bootloader            &none        &none        &none        &none &none &none
        &studio_unlock &none        &none        &none        &none        &none        &none                   &none &none &bt BT_CLR &none                      &stp STP_BAT &none        &none        &none        &none &none &none
        &none &none        &none        &none        &macro_ver   &none                                      &none &none                                                        &none        &none        &none        &none &none &none
        &none &none        &none        &none        &none                                       &none &none &none &none      &bl BL_TOG &rgb_ug RGB_TOG                                     &bl BL_INC   &bl BL_DEC   &none &none &none
      >;
    };

    mods_on_home {
      display-name = "Homerow mods on homerow";
      bindings = <
        &trans   &trans     &trans      &trans      &trans     &trans &trans                                                   &trans  &trans  &trans     &trans        &trans        &trans       &trans
        &trans   &kp Q      &kp W       &kp F       &kp P      &kp G  &to 0                                                   &trans  &kp J   &kp L      &kp U         &kp Y         &kp SEMI     &trans
        &trans   &hm LALT A &hm LCTRL R &hm LSHFT S &hm LGUI T &kp D  &trans             &trans &trans &trans  &trans          &trans  &kp H   &hm RGUI N &hm RSHFT E   &hm RCTRL I   &hm RALT O   &trans
        &trans   &kp Z      &kp X       &kp C       &kp V      &kp B                            &trans &trans                          &kp K   &kp M      &kp COMMA     &kp DOT       &kp SLASH    &trans
        &trans   &trans     &caps_word  &trans      &trans                        &trans &trans &trans &trans  &trans &trans                   &trans     &trans        &trans        &trans       &trans
      >;
    };

    extra1 {
      display-name = "Red";
      status = "reserved";
    };

    extra2 {
      display-name = "Purple";
      status = "reserved";
    };

    // extra3 {
    //   display-name = "Cyan";
    //   status = "reserved";
    // };

    // extra4 {
    //   display-name = "Yellow";
    //   status = "reserved";
    // };
  };
};
